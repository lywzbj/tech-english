# Copy to .env and adjust. Never commit .env.
#
# Default runtime database is SQLite; no server and no database password needed.
# The file is created automatically at backend/data/tech-english.db.
# SQLITE_PATH=./data/tech-english.db

JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long
# AI chat goes through Spring AI. mock works with no API key.
# AI_PROVIDER is a free-form label: "mock" uses the offline stub, any other name
# (openai, deepseek, qwen, vllm, one-api, company-gateway, ...) means "an OpenAI
# Chat Completions-compatible service" reachable at AI_BASE_URL. Nothing else in
# the stack is vendor-specific — point AI_BASE_URL / AI_MODEL at any provider
# that serves /chat/completions. Example (in-house gateway):
#   AI_PROVIDER=company-gateway
#   AI_BASE_URL=http://10.0.0.1:8000/v1
#   AI_MODEL=Qwen/Qwen3.8-Flash-Next-NVFP4
AI_PROVIDER=mock
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_SECONDS=45
# Active prompt version per purpose. Files live in the backend classpath at
# resources/prompts/<purpose>/<version>-system.md (system-level) and
# -user.md (conversation-level template). Changing the version here switches
# prompts without a code change; the app fails to start if the files are missing.
AI_PROMPT_VERSION_EXPLAIN=v2
# Other prompt purposes (grammar-explain, writing-review, question-gen,
# exercise-gen, ability-assess, preview) currently all default to v1; override
# each with its own AI_PROMPT_VERSION_<PURPOSE> variable to roll a new version
# out or back.
AI_PROMPT_VERSION_GRAMMAR_EXPLAIN=v1
AI_PROMPT_VERSION_WRITING_REVIEW=v1
AI_PROMPT_VERSION_QUESTION_GEN=v1
AI_PROMPT_VERSION_EXERCISE_GEN=v1
AI_PROMPT_VERSION_ABILITY_ASSESS=v1
AI_PROMPT_VERSION_PREVIEW=v1

# AI 模块控制台日志级别(com.techenglish.ai)。
# TRACE=开发调试,打印提示词原文与模型原始回复;INFO=生产,只留调用摘要;WARN=只留降级/失败。
LOG_LEVEL_AI=INFO
# Spring AI 框架自身日志;DEBUG 会输出完整 HTTP 请求/响应体,仅排障时临时使用。
LOG_LEVEL_SPRING_AI=WARN

# Vector search. The default local hashing embedder needs no API key.
VECTOR_ENABLED=true
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# vec0.dll / vec0.so / vec0.dylib location, without the platform suffix.
SQLITE_VEC_EXTENSION=lib/sqlite-vec/vec0

# Optional MySQL profile: add --spring.profiles.active=mysql
# Run scripts/init-mysql.sql first.
MYSQL_URL=jdbc:mysql://localhost:3306/tech_english?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=tech_english
MYSQL_PASSWORD=change-me
